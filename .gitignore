# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# EEG and experiment data: never commit real subject data
data/
**/data/
*.npz
*.npy
*.edf
*.bdf
*.fif
*.set
*.vhdr
*.vmrk
*.eeg
*.cnt
*.mat

# Local Claude Code overrides (true per-machine secrets stay ignored)
.claude/settings.local.json
**/.claude/settings.local.json

# Project-level Claude settings that ARE meant to sync across machines
# (these are exceptions: same file name, but lives inside a subproject we
# explicitly want versioned — see MIGRATION.md §4.2)
!P4_EEG/p8_mi_car/.claude/settings.local.json

# Vendor / local device bundles (do not version)
eConScan_AiO/
iRecorder*/

# Stimulus videos (large binaries; keep locally)
**/sucai/
*.mp4

# Temporary scratch outputs
scratch/
tmp/
*.tmp

# Pipeline 衍生产物（含被试预处理 raw / epochs / 特征 / QC HTML，与 data/ 同隐私级别）
derivatives/
**/derivatives/

# 视频动作提取产物 (parquet / events.csv / preview mp4 等)，可重跑，不入库
**/analysis_outputs/

# Obsidian per-machine UI state (not the vault config)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspaces.json
